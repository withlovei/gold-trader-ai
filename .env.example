# GoldTrader does NOT need a .env file to run. Secrets (MT5 password, Telegram bot token) are
# entered in the dashboard and stored encrypted with Windows DPAPI inside data/app.db
# (git-ignored). Copy this file to .env only if you want to set the optional variables below
# in your shell/launcher; never commit a real .env.

# Path to the Claude CLI (claude.exe). Optional: if empty, GoldTrader looks on PATH, then in the
# newest VS Code extension "anthropic.claude-code-*" folder.
CLAUDE_CLI=

# Set to 0 to start the API server WITHOUT the background autopilot thread: no background
# decisions and no daily meeting. NOTE: while a dashboard tab is open it still polls /api/live,
# which runs the same decision step, so use mode "Chỉ xem" (analysis) to guarantee no orders.
# Default: 1.
GOLDTRADER_AUTOPILOT=1
